@ECHO OFF
ECHO Building Harness98 GUI, CLI, launcher, and helpers...
SET CSC=%WINDIR%\Microsoft.NET\Framework\v2.0.50727\csc.exe
IF EXIST "%CSC%" GOTO COMPILE
ECHO ERROR: The .NET Framework 2.0 compiler was not found.
ECHO Expected: %CSC%
GOTO FAILED
:COMPILE
ECHO Copying runtime dependencies...
IF NOT EXIST "VENDOR\LIBCURL-WIN98\LibCurlNet.dll" GOTO VERIFYDLLS
COPY /Y "VENDOR\LIBCURL-WIN98\LibCurlNet.dll" . >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y "VENDOR\LIBCURL-WIN98\LibCurlShim.dll" . >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y "VENDOR\LIBCURL-WIN98\libcurl.dll" . >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y "VENDOR\LIBCURL-WIN98\libeay32.dll" . >NUL
IF ERRORLEVEL 1 GOTO FAILED
COPY /Y "VENDOR\LIBCURL-WIN98\ssleay32.dll" . >NUL
IF ERRORLEVEL 1 GOTO FAILED
:VERIFYDLLS
IF NOT EXIST LibCurlNet.dll GOTO MISSINGDLLS
IF NOT EXIST LibCurlShim.dll GOTO MISSINGDLLS
IF NOT EXIST libcurl.dll GOTO MISSINGDLLS
IF NOT EXIST libeay32.dll GOTO MISSINGDLLS
IF NOT EXIST ssleay32.dll GOTO MISSINGDLLS
IF EXIST CACERT.PEM GOTO BUILDFILES
IF NOT EXIST "EXPERIMENTS\CURL-TLS\cacert.pem" GOTO MISSINGCERT
COPY /Y "EXPERIMENTS\CURL-TLS\cacert.pem" CACERT.PEM >NUL
IF ERRORLEVEL 1 GOTO FAILED
:BUILDFILES
"%CSC%" @BUILD\WINDOWS98\UPDATER.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @BUILD\WINDOWS98\LAUNCHER.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @BUILD\WINDOWS98\RESTART.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @BUILD\WINDOWS98\GUI.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @BUILD\WINDOWS98\CLI.RSP
IF ERRORLEVEL 1 GOTO FAILED
ECHO Build succeeded: HARNESS98.EXE, H98GUI.EXE, H98CLI.EXE, and H98RESTART.EXE
GOTO END
:MISSINGDLLS
ECHO ERROR: The LibCurl runtime dependency set is incomplete.
GOTO FAILED
:MISSINGCERT
ECHO ERROR: CACERT.PEM and its source certificate bundle are missing.
GOTO FAILED
:FAILED
ECHO Build failed.
:END
PAUSE
