@ECHO OFF
ECHO Building Harness98 3.1.0 GUI and CLI...
SET CSC=%WINDIR%\Microsoft.NET\Framework\v2.0.50727\csc.exe
IF EXIST "%CSC%" GOTO COMPILE
ECHO ERROR: The .NET Framework 2.0 compiler was not found.
ECHO Expected: %CSC%
GOTO FAILED
:COMPILE
"%CSC%" @UPDATER.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @GUI31.RSP
IF ERRORLEVEL 1 GOTO FAILED
"%CSC%" @CLI31.RSP
IF ERRORLEVEL 1 GOTO FAILED
ECHO Build succeeded: HARNESS98.EXE and H98CLI.EXE
GOTO END
:FAILED
ECHO Build failed.
:END
PAUSE
